rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Equipment images – public read, signed-in write
    match /equipment/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Service media – public read, signed-in write
    match /serviceMedia/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Root assets – public read, signed-in write
    match /rootAssets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Equipment videos – public read, signed-in write
    match /equipment-videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Works thumbnails – public read, signed-in write
    match /works-thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Works videos – public read, signed-in write
    match /works-videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validMessage() {
      return request.resource.data.keys().hasOnly([
        'name',
        'email',
        'phone',
        'service',
        'subject',
        'message',
        'source',
        'read',
        'createdAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.email is string
      && request.resource.data.email.size() > 3
      && request.resource.data.email.size() <= 180
      && (!('phone' in request.resource.data) || request.resource.data.phone is string)
      && (!('service' in request.resource.data) || request.resource.data.service is string)
      && request.resource.data.message is string
      && request.resource.data.message.size() > 0
      && request.resource.data.message.size() <= 3000
      && (!('subject' in request.resource.data) || request.resource.data.subject is string)
      && (!('source' in request.resource.data) || request.resource.data.source is string)
      && request.resource.data.read == false;
    }

    match /messages/{messageId} {
      allow create: if validMessage();
      allow read, update, delete: if signedIn();
    }

    match /equipment/{equipmentId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /works/{workId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    // Equipment submission requests from visitors
    match /equipment_requests/{requestId} {
      allow create: if
        request.resource.data.submitterName is string &&
        request.resource.data.submitterName.size() > 0 &&
        request.resource.data.submitterEmail is string &&
        request.resource.data.submitterEmail.size() > 3 &&
        request.resource.data.equipmentName is string &&
        request.resource.data.equipmentName.size() > 0 &&
        request.resource.data.status == "pending";
      allow read, update, delete: if signedIn();
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
